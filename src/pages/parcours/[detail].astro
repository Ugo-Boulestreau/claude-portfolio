---
import DetailPage from '../../components/pages/DetailPage.astro';
import { detailPaths } from '../../data/details';

// Une page par fichier de src/content/details/fr/ : /parcours/<id>/
export const getStaticPaths = () => detailPaths('fr');

// Toujours défini : getStaticPaths ne génère que des pages avec ce paramètre.
const { detail } = Astro.params as { detail: string };
---

<DetailPage lang="fr" id={detail} />
