---
import PlacementPage from '../../components/pages/PlacementPage.astro';
import { placementPaths } from '../../data/placementDetails';

// Une page par fichier de src/content/placements/fr/ : /parcours/<id>/
export const getStaticPaths = () => placementPaths('fr');

// Toujours défini : getStaticPaths ne génère que des pages avec ce paramètre.
const { placement } = Astro.params as { placement: string };
---

<PlacementPage lang="fr" id={placement} />
