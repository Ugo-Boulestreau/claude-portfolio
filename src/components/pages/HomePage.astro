---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import profil from '../../assets/profil.jpg';
import ProjectCard from '../ProjectCard.astro';
import { site } from '../../data/site';
import { getProjects } from '../../i18n/projects';
import type { Lang } from '../../i18n/ui';
import { pagePath, useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
const featured = projects.filter((project) => project.data.featured);
// Tant qu'il n'y a aucun projet, le bouton principal mène au parcours plutôt qu'à une page vide.
const mainCta =
  projects.length > 0
    ? { href: pagePath('projects', lang), label: t('home.cta.projects') }
    : { href: pagePath('experience', lang), label: t('projects.wip.experience') };
---

<Base lang={lang} page="home" title={t('home.title')} description={t('home.description')}>
  <section class="container hero">
    <div>
      <p class="status">{t('home.status')}</p>
      <h1>{site.name}</h1>
      <p class="role">{t('home.role')}</p>
      <p class="lead">{t('home.intro')}</p>
      <p class="actions">
        <a class="button button--primary" href={mainCta.href}>{mainCta.label}</a>
        <a class="button" href={pagePath('contact', lang)}>{t('home.cta.contact')}</a>
      </p>
    </div>
    <!-- Visible dès l'ouverture : chargée tout de suite, en priorité. -->
    <Image src={profil} alt={t('home.photoAlt')} width={480} class="photo" loading="eager" fetchpriority="high" />
  </section>

  <section class="container section" aria-labelledby="about">
    <div class="about">
      <h2 id="about">{t('home.about.title')}</h2>
      <p>{t('home.about.p1')}</p>
      <p>{t('home.about.p2')}</p>
      <p>{t('home.about.p3')}</p>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="container section" aria-labelledby="featured">
        <h2 id="featured">{t('home.featured')}</h2>
        <ul class="grid" role="list">
          {featured.map((project) => (
            <li>
              <ProjectCard project={project} lang={lang} heading="h3" />
            </li>
          ))}
        </ul>
        <p class="more">
          <a href={pagePath('projects', lang)}>{t('home.allProjects')} →</a>
        </p>
      </section>
    )
  }
</Base>

<style>
  .about {
    max-width: 44rem;
    padding: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius);
  }

  .about p:last-child {
    margin-bottom: 0;
  }

  .hero {
    display: flex;
    /* Sur mobile, la photo (placée après le texte dans le HTML) passe au-dessus. */
    flex-direction: column-reverse;
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-4);
  }

  .photo {
    flex-shrink: 0;
    width: 9rem;
    aspect-ratio: 1;
    /* Recadrage en rond, centré sur le visage. */
    object-fit: cover;
    object-position: 50% 25%;
    border: 3px solid var(--border);
    border-radius: 50%;
  }

  @media (min-width: 48rem) {
    .hero {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .photo {
      width: 15rem;
    }
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.2rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.875rem;
  }

  .status::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #3fb950;
  }

  h1 {
    margin-bottom: var(--space-1);
  }

  .role {
    color: var(--accent);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .more {
    margin-top: var(--space-3);
    font-weight: 600;
  }
</style>
